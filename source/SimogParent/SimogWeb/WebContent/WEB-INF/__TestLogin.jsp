<%@ page contentType="text/html; charset=iso-8859-1" language="java" errorPage="errore.jsp" %>
<%@ include file="include/newbasicHeader.inc" %>
<%@ page import="it.avlp.simog.common.servlet.*" %>
<%@page import="it.avlp.simog.util.SimogProperties"%>
<%@ taglib prefix="utils" uri="http://simog.avlp.it/tags-util"  %>

<script type="text/javascript" src="xtree/treeutils.js"></script>

<script type="text/javascript">
//<!--
function scegli(cosa){
	var obj = document.getElementById("SAMLResponse");
	if(cosa == "RUP"){
		//obj.value="";
		obj.value="";
	}
	else if(cosa == "OSSR"){
		obj.value="";
		}
	else if(cosa == "ADMIN"){
		obj.value="";
	}
	
	document.forms[0].submit();
}
function selscegli(nome){
	var obj = document.getElementById(nome);
	obj.checked=true;
	
	document.forms[0].submit();
}
//-->
</script>
</head>
<body onload="f_setfocus(document.forms[0])">
<div id="gabbia">  
<div id="header">
</div>
	<div id="bodypage">	
		<div class="bodypage-e">
			<h4>Accesso SIMOG per test funzionali<font color="red"><big>
			
			<%= SimogProperties.getInstance().getAmbiente() %>
			</big></font></h4>
			<br>
			<%@ include file="include/gestisciErrore.inc" %>

			<form name="frmLogin" method="post" action="checkAuthentication">
			<input type="hidden" name="SAMLResponse" id="SAMLResponse" value='***' />
			<fieldset id="fldlogin">
			<legend>Selezionare un profilo per l'accesso </legend>
			<table>
			<tr> 
				<td>
					<input id="radio_RUP" onclick="javascript:scegli('RUP');" type="button" value="Responsabile unico del procedimento"  /> 
					<br><br>
				</td>
			</tr>
			<tr> 
				<td>
					<input id="radio_OSSR" onclick="javascript:scegli('OSSR');" type="button" value="Osservatorio regionale"  /> 
					<br><br>
				</td>
			</tr>
			<tr> 
				<td>
					<input id="radio_ADMIN" onclick="javascript:scegli('ADMIN');" type="button" value="Amministratore"  /> 
					<br><br>
				</td>
			</tr>
			</table>
			</fieldset>
			</form>
		</div>		
	</div>
	<%@ include file="include/newfooter.inc" %>
</div>
</body>
</html>
