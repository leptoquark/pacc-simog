<?xml version="1.0" encoding="UTF-8" ?>

<taglib xmlns="http://java.sun.com/xml/ns/j2ee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://java.sun.com/xml/ns/j2ee http://java.sun.com/xml/ns/j2ee/web-jsptaglibrary_2_0.xsd"
    version="2.0">
   
	  <description>Libreria di tag... </description>
      <tlib-version>1.1</tlib-version>
      <short-name>utilita</short-name>
      <uri>http://simog.avlp.it/tags-util</uri>
      
      

  
	<tag>
		<description>se l'utente e gia autenticato lo porta alla sua homepage</description>
		<name>canGoHome</name>
		<tag-class>it.avlp.simog.tags.SendUserHomeTag</tag-class>
		<body-content>empty</body-content>
		
				
	</tag>
	<tag>
		<description>restituisce il valore inserito in precedenza</description>
		<name>requestParameter</name>
		<tag-class>it.avlp.simog.tags.GetRequestParameterTag</tag-class>
		<body-content>empty</body-content>
		
		<attribute>
			<name>property</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>defaultValue</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>

	</tag>
	
	<tag>
		<description>seleziona una checkbox se element fa parte di list</description>
		<name>checkElement</name>
		<tag-class>it.avlp.simog.tags.ContainsTag</tag-class>
		<body-content>empty</body-content>
		
		<attribute>
			<name>list</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>element</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>

	</tag>
	<tag>
		<description>Visualizza il corpo del tag solo se tipoScheda e contenuto in mostraCon o tipoScheda e vuoto</description>
		<name>visualizzaCampo</name>
		<tag-class>it.avlp.simog.tags.ViewRulesTag</tag-class>
		<body-content>JSP</body-content>
		
		<attribute>
			<name>tipoScheda</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>mostraCon</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>

	</tag>
	
	<tag>
		<description>stampa una lista di opzioni con valori in 'optionList'</description>
		<name>options</name>
		<tag-class>it.avlp.simog.tags.OptionListTag</tag-class>
		<body-content>empty</body-content>
		
		<attribute>
			<name>name</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>scope</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>value</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>valLocation</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
      <attribute>
         <name>revert</name>
         <required>false</required>
         <rtexprvalue>true</rtexprvalue>
      </attribute>
      <attribute>
         <name>limit</name>
         <required>false</required>
         <rtexprvalue>true</rtexprvalue>
      </attribute>
	</tag>
	
   <tag>
      <description>stampa una lista di opzioni con valori in 'optionList' senza riordinarli</description>
      <name>optionsLinked</name>
      <tag-class>it.avlp.simog.tags.OptionListTagLinked</tag-class>
      <body-content>empty</body-content>
      
      <attribute>
         <name>name</name>
         <required>true</required>
         <rtexprvalue>true</rtexprvalue>
      </attribute>
      <attribute>
         <name>scope</name>
         <required>false</required>
         <rtexprvalue>true</rtexprvalue>
      </attribute>
      <attribute>
         <name>value</name>
         <required>false</required>
         <rtexprvalue>true</rtexprvalue>
      </attribute>
      <attribute>
         <name>valLocation</name>
         <required>false</required>
         <rtexprvalue>true</rtexprvalue>
      </attribute>
      <attribute>
         <name>revert</name>
         <required>false</required>
         <rtexprvalue>true</rtexprvalue>
      </attribute>
   </tag>

	<tag>
		<description>Crea una lista di checkbox e seleziona quelli contenuti in checkedList</description>
		<name>createCheckGroup</name>
		<tag-class>it.avlp.simog.tags.CheckboxGroupTag</tag-class>
		<body-content>empty</body-content>
		
		
		<attribute>
			<name>listaCheckBox</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>checkedList</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		
		<attribute>
			<name>fieldName</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		
		<attribute>
			<name>campoId</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		
		<attribute>
			<name>campoVisualizzato</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		
		<attribute>
			<name>disabled</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			
		</attribute>
		
		<attribute>
			<name>onchange</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
	
	<tag>
		<description>Crea una lista di checkbox e seleziona quelli contenuti in checkedList</description>
		<name>multibox</name>
		<tag-class>it.avlp.simog.tags.MultiboxTag</tag-class>
		<body-content>empty</body-content>
		
		<attribute>
			<name>lista</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
			
		</attribute>
		<attribute>
			<name>listaCampiSelezionati</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		
		<attribute>
			<name>idField</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		
		<attribute>
			<name>campo</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		
		<attribute>
			<name>scope</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		
		<attribute>
			<name>disabled</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			
		</attribute>
		
		<attribute>
			<name>readonly</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			
		</attribute>
		
		<attribute>
			<name>onchange</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
	
	<tag>
		<description>Crea due pulsanti radio ...blah</description>
		<name>selectBooleanRadio</name>
		<tag-class>it.avlp.simog.tags.SelectBooleanRadio</tag-class>
		<body-content>empty</body-content>

		<attribute>
			<name>name</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
			
		</attribute>
		<attribute>
			<name>value</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		
		<attribute>
			<name>rendered</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		
		<attribute>
			<name>trueId</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		
		<attribute>
			<name>falseId</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>trueVal</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>falseVal</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>trueLabel</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>falseLabel</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		
		<attribute>
			<name>disabled</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			
		</attribute>
		
		<attribute>
			<name>readonly</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			
		</attribute>
		
		<attribute>
			<name>tabindex</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			
		</attribute>
		<attribute>
			<name>onchange</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			
		</attribute>
		
		<attribute>
			<name>onclick</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			
		</attribute>
		
      <attribute>
         <name>triState</name>
         <required>false</required>
         <rtexprvalue>true</rtexprvalue>
         
      </attribute>
		
	</tag>
	
	<tag>
		<description>
		      <![CDATA[Crea una serie di tag html option del tipo:
		      <option value='destination_path'>descrizione link</option>
		      Il tag deve essere inserito all'interno di un tag select.
		      esempio:
		      	<select ... onclick='funzioneCheTiPortaAlPathSelezionato(this)'>
		           <u:navigatonRules navigationListName='someName' loadStyle='someStyle' newStyle='someStyle2' delegante='false' />
		     	 </select>
		      ]]>
		      
		
		</description>
		<name>navigationCombo</name>
		<tag-class>it.avlp.simog.tags.NavigationComboTag</tag-class>
		<body-content>empty</body-content>
		<attribute>
			<name>aggiudId</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>loadStyle</name>
			<required>false</required>
			<rtexprvalue>false</rtexprvalue>
		</attribute>
		<attribute>
			<name>disabledStyle</name>
			<required>false</required>
			<rtexprvalue>false</rtexprvalue>
		</attribute>
		<attribute>
			<name>newStyle</name>
			<required>false</required>
			<rtexprvalue>false</rtexprvalue>
		</attribute>
		<attribute>
			<name>pendingStyle</name>
			<required>false</required>
			<rtexprvalue>false</rtexprvalue>
		</attribute>
		<attribute>
			<name>delegante</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
   
    <function>
        <name>contains</name>
        <function-class>it.avlp.simog.tags.ContainsFunction</function-class>
        <function-signature>boolean contains(java.util.List,java.lang.Object)</function-signature>
    </function>
	
	<tag>
		<description>Visualizza un messaggio internazionalizzato. Usa plain="true" quando il messaggio viene usato in attributi HTML come title="..." per evitare HTML malformato.</description>
		<name>message</name>
		<tag-class>it.avlp.simog.tags.MessageTag</tag-class>
		<body-content>empty</body-content>
		
		<attribute>
			<name>key</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>plain</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<description>Se true, il messaggio viene output senza wrapping in &lt;span&gt;. Utile per attributi HTML come title="..."</description>
		</attribute>
		<attribute>
			<name>param1</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>param2</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>param3</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>param4</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>param5</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
	
</taglib>